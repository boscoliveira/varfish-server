# Environment variables for AWS App Runner
# Set these in App Runner Console > Service > Configuration > Environment Variables

# Core Django settings
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=your-long-random-secret-key-here
DJANGO_ALLOWED_HOSTS=*

# Database (use RDS PostgreSQL)
DATABASE_URL=postgresql://username:password@your-rds-endpoint.region.rds.amazonaws.com:5432/varfish

# Redis (use ElastiCache)
CELERY_BROKER_URL=redis://your-elasticache-endpoint:6379/0

# Partitioning (adjust based on expected scale)
VARFISH_PARTITION_MODULUS_SMALLVARIANT=256

# External services (disable Mehari if not using)
VARFISH_BACKEND_URL_ANNONARS=http://your-annonars-service:8080
VARFISH_BACKEND_URL_VIGUNO=http://your-viguno-service:8080
VARFISH_BACKEND_URL_MEHARI=http://mehari-disabled
VARFISH_ENABLE_BEACON_SITE=1

# S3 storage (recommended for App Runner)
VARFISH_USE_S3=1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=your-varfish-bucket
AWS_S3_ENDPOINT_URL=https://s3.amazonaws.com
AWS_DEFAULT_REGION=us-east-1

# Optional: reduce startup waits
DB_WAIT_ATTEMPTS=30
DB_WAIT_SLEEP_SECONDS=10
