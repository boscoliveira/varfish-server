# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-access-key
AWS_S3_ENDPOINT_URL=https://s3.amazonaws.com
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name

# Database Configuration
# For external database (e.g., Render, AWS RDS)
DATABASE_URL=postgresql://user:password@host:5432/database
# For local Docker PostgreSQL
# DATABASE_URL=postgresql://varfish:changeme@postgres:5432/varfish

# Redis Configuration
# For external Redis (e.g., Render, ElastiCache)
CELERY_BROKER_URL=redis://host:6379
# For local Docker Redis
# CELERY_BROKER_URL=redis://redis:6379/0

# Database connection settings
DB_WAIT_ATTEMPTS=120
DB_WAIT_SLEEP_SECONDS=10

# Django Settings
DJANGO_ALLOWED_HOSTS=*
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.production

# Application Port
PORT=8080

# VarFish Backend Services
VARFISH_BACKEND_URL_ANNONARS=http://annonars:8080
VARFISH_BACKEND_URL_MEHARI=http://mehari-disabled
VARFISH_BACKEND_URL_VIGUNO=http://viguno:8080

# VarFish Features
VARFISH_ENABLE_BEACON_SITE=1
VARFISH_PARTITION_MODULUS_SMALLVARIANT=32
VARFISH_USE_S3=1

# Service Discovery / Health Checks
WAIT_HOSTS=postgres:5432,redis:6379
WAIT_HOSTS_TIMEOUT=600
WAIT_SLEEP_SECONDS=2

# Optional: Encryption key for sensitive data
FIELD_ENCRYPTION_KEY=your-32-byte-encryption-key-change-in-production